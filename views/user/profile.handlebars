<div class="perfil-pagina">

  <!-- Cabecera del perfil -->
  <section class="perfil-cabecera">
    <div class="perfil-portada" aria-hidden="true"></div>
    <div class="perfil-info">
      {{#if user.profileImage}}
        <img class="avatar avatar-xl" src="{{user.profileImage}}" alt="Foto de perfil de {{user.username}}">
      {{else}}
        <span class="avatar avatar-xl" aria-hidden="true">{{user.username}}</span>
      {{/if}}

      <div class="perfil-datos">
        <h1>
          {{user.username}}
          {{#if (igual user.role "admin")}}<span class="etiqueta etiqueta-admin">Administrador</span>{{/if}}
        </h1>
        <p class="meta">{{user.email}}</p>
        {{#if user.description}}
          <p class="perfil-bio">{{user.description}}</p>
        {{/if}}
      </div>

      <div class="perfil-acciones">
        <a class="boton-principal" href="#subir">＋ Subir video</a>
        <button class="boton-contorno" type="button">Editar perfil</button>
      </div>
    </div>

    <dl class="perfil-stats">
      <div><dt>Videos publicados</dt><dd>{{videos.length}}</dd></div>
      <div><dt>Miembro desde</dt><dd>{{fecha user.createdAt}}</dd></div>
    </dl>
  </section>

  <!-- Pestañas -->
  <nav class="pestanas" aria-label="Secciones del perfil">
    <a href="#mis-videos">Mis videos <span class="contador">{{videos.length}}</span></a>
    <a href="#subir">Subir video</a>
    <a href="#notificaciones">Notificaciones <span class="contador contador-alerta">3</span></a>
  </nav>

  <div class="paneles">

    <!-- Mis videos -->
    <section id="mis-videos" class="panel panel-inicial">
      {{#if videos.length}}
        <div class="rejilla">
          {{#each videos}}
            {{> video-card}}
          {{/each}}
        </div>
      {{else}}
        <div class="vacio-caja">
          <p class="vacio-titulo">Todavía no has publicado videos</p>
          <p>Comparte tu primer video con la comunidad.</p>
          <a class="boton-principal" href="#subir">Subir mi primer video</a>
        </div>
      {{/if}}
    </section>

    <!-- Subir video (maqueta, falta implementar la funcionalidad) -->
    <section id="subir" class="panel">
      <div class="subir-layout">
        <div class="tarjeta-panel">
          <h2>Subir un video</h2>
          <p class="meta">Completa los datos de tu publicación.</p>

          <!-- Cuando lo implementemos se debe cambiar action/method y usar un botón type="submit" -->
          <form class="subir-form" action="#subir" method="get" enctype="multipart/form-data">
            <div class="campo">
              <label for="video-titulo">Título</label>
              <input id="video-titulo" type="text" name="title" maxlength="150" placeholder="Ej. Introducción a Express en 10 minutos">
            </div>

            <div class="campo">
              <label for="video-descripcion">Descripción</label>
              <textarea id="video-descripcion" name="description" rows="4" maxlength="2000" placeholder="Cuéntale a la comunidad de qué trata tu video"></textarea>
              <small class="ayuda">Opcional · máximo 2000 caracteres.</small>
            </div>

            <div class="campo">
              <label for="video-categoria">Categoría</label>
              <select id="video-categoria" name="categoryId">
                <option value="">Elige una categoría</option>
                {{#if categorias.length}}
                  {{#each categorias}}
                    <option value="{{_id}}">{{name}}</option>
                  {{/each}}
                {{else}}
                  <option>Tecnología</option>
                  <option>Educación</option>
                  <option>Música</option>
                  <option>Videojuegos</option>
                  <option>Cocina</option>
                  <option>Deportes</option>
                {{/if}}
              </select>
            </div>

            <div class="fila-2">
              <div class="campo">
                <span class="etiqueta-campo">Archivo de video</span>
                <label class="zona-archivo" for="video-archivo">
                  <span class="zona-icono" aria-hidden="true">🎬</span>
                  <strong>Arrastra tu video o haz clic para elegirlo</strong>
                  <span class="meta">MP4 o WebM</span>
                  <input id="video-archivo" type="file" name="videoFile" accept="video/*">
                </label>
              </div>

              <div class="campo">
                <span class="etiqueta-campo">Miniatura</span>
                <label class="zona-archivo" for="video-miniatura">
                  <span class="zona-icono" aria-hidden="true">🖼️</span>
                  <strong>Elige una imagen de portada</strong>
                  <span class="meta">JPG o PNG · opcional</span>
                  <input id="video-miniatura" type="file" name="thumbnailFile" accept="image/*">
                </label>
              </div>
            </div>

            <div class="subir-acciones">
              <a class="boton-contorno" href="#mis-videos">Cancelar</a>
              <button class="boton-principal" type="button">Publicar video</button>
            </div>
          </form>
        </div>

        <aside class="vista-previa">
          <h3>Así se verá tu video</h3>
          <article class="tarjeta">
            <div class="miniatura"><div class="sin-miniatura">▶</div></div>
            <h3>Título de tu video</h3>
            <p class="meta">{{user.username}} · <span class="etiqueta">Categoría</span></p>
            <p class="meta">0 vistas · 0 me gusta</p>
          </article>

          <div class="consejos">
            <h4>Consejos para publicar</h4>
            <ul>
              <li>Usa un título claro y descriptivo.</li>
              <li>Elige la categoría que mejor lo describa.</li>
              <li>Una buena miniatura ayuda a que te encuentren.</li>
            </ul>
          </div>
        </aside>
      </div>
    </section>

    <!-- Notificaciones (es una maqueta, se debera cambiar mas adelante) -->
    <section id="notificaciones" class="panel">
      <div class="tarjeta-panel">
        <div class="panel-cabecera">
          <div>
            <h2>Notificaciones</h2>
            <p class="meta">Tienes 3 notificaciones sin leer.</p>
          </div>
          <button class="boton-contorno" type="button">Marcar todas como leídas</button>
        </div>
        {{> notificaciones-lista}}
      </div>
    </section>

  </div>
</div>
