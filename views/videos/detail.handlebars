<div class="detalle-pagina">

  <article class="detalle">
    <div class="reproductor-marco">
      <video id="reproductor" controls preload="metadata" {{#if video.thumbnailUrl}}poster="{{video.thumbnailUrl}}"{{/if}} src="{{video.videoUrl}}">
        Tu navegador no puede reproducir este video.
      </video>
    </div>

    <h1 class="detalle-titulo">{{video.title}}</h1>

    <div class="detalle-barra">
      <div class="autor">
        <span class="avatar" aria-hidden="true">{{video.author.username}}</span>
        <div>
          <strong>{{video.author.username}}</strong>
          <span class="meta">Publicado el {{fecha video.publishedAt}}</span>
        </div>
      </div>

      <!-- Maqueta el boton cambia de aspecto con CSS, pero aún no guarda nada -->
      <div class="acciones">
        <input class="like-check" type="checkbox" id="like-video">
        <label class="boton-like" for="like-video">
          <span class="corazon" aria-hidden="true"></span>
          <span>Me gusta</span>
          <span class="conteo">{{video.likesCount}}</span>
        </label>
        <button class="boton-contorno" type="button">↗ Compartir</button>
      </div>
    </div>

    <div class="detalle-descripcion">
      <p class="meta">
        <strong><span id="vistas">{{video.views}}</span> vistas</strong> ·
        <a class="etiqueta" href="/videos?category={{video.category.categoryId}}">{{video.category.name}}</a>
      </p>
      {{#if video.description}}
        <p>{{video.description}}</p>
      {{else}}
        <p class="vacio">Este video no tiene descripción.</p>
      {{/if}}
    </div>
  </article>

  <section class="comentarios-seccion" id="comentarios">
    <header class="comentarios-cabecera">
      <h2>Comentarios <span class="contador">{{comentarios.length}}</span></h2>
      <label class="orden">Ordenar por
        <select name="orden">
          <option>Más recientes</option>
          <option>Más gustados</option>
        </select>
      </label>
    </header>

    <!-- Nuevo comentario (maqueta, no tiene funcionalidad, se implementara a futuro) -->
    {{#if user}}
      <form class="comentar" action="#comentarios" method="get">
        <span class="avatar" aria-hidden="true">{{user.username}}</span>
        <div class="comentar-campo">
          <label class="solo-lectores" for="nuevo-comentario">Escribe un comentario</label>
          <textarea id="nuevo-comentario" name="content" rows="2" maxlength="1000" placeholder="Agrega un comentario público…"></textarea>
          <div class="comentar-pie">
            <small class="ayuda">Máximo 1000 caracteres.</small>
            <div class="comentar-botones">
              <button class="boton-texto" type="reset">Cancelar</button>
              <button class="boton-principal" type="button">Comentar</button>
            </div>
          </div>
        </div>
      </form>
    {{else}}
      <div class="comentar comentar-invitado">
        <div>
          <strong>¿Quieres participar?</strong>
          <p class="meta">Inicia sesión para comentar y dar me gusta.</p>
        </div>
        <div class="comentar-botones">
          <a class="boton-principal" href="/login">Iniciar sesión</a>
          <a class="boton-contorno" href="/register">Crear cuenta</a>
        </div>
      </div>
    {{/if}}

    {{#if comentarios.length}}
      <ul class="comentarios">
        {{#each comentarios}}
          <li class="comentario">
            <span class="avatar avatar-sm" aria-hidden="true">{{author.username}}</span>
            <div class="comentario-cuerpo">
              <p class="comentario-cabecera"><strong>{{author.username}}</strong> <span class="meta">{{fecha createdAt}}</span></p>
              <p class="comentario-texto">{{content}}</p>
              <div class="comentario-acciones">
                <input class="like-check" type="checkbox" id="like-comentario-{{@index}}">
                <label class="boton-like boton-like-mini" for="like-comentario-{{@index}}">
                  <span class="corazon" aria-hidden="true"></span>
                  <span>Me gusta</span>
                </label>
                <button class="boton-texto" type="button">Responder</button>
              </div>
            </div>
          </li>
        {{/each}}
      </ul>
    {{else}}
      <div class="vacio-caja">
        <p class="vacio-titulo">Aún no hay comentarios</p>
        <p>Sé la primera persona en comentar este video.</p>
      </div>
    {{/if}}
  </section>

  <p><a href="/videos">← Volver al listado</a></p>
</div>

<script>
  // Registra una reproducción en la API la primera vez que se da play
  (function () {
    var reproductor = document.getElementById("reproductor");
    var contado = false;
    reproductor.addEventListener("play", function () {
      if (contado) return;
      contado = true;
      fetch("/api/videos/{{video._id}}/views", { method: "POST" })
        .then(function (r) { return r.json(); })
        .then(function (v) { if (v && v.views !== undefined) document.getElementById("vistas").textContent = v.views; })
        .catch(function () {});
    });
  })();
</script>
