<section>
  <h1>Bienvenido a VideoHub</h1>
  <p>Plataforma para publicar y explorar videos de tu comunidad.</p>
</section>

<section>
  <h2>Categorías</h2>
  {{#if categorias.length}}
    <div class="etiquetas">
      {{#each categorias}}
        <a class="etiqueta" href="/videos?category={{_id}}">{{name}}</a>
      {{/each}}
    </div>
  {{else}}
    <p class="vacio">Todavía no hay categorías.</p>
  {{/if}}
</section>

<section>
  <h2>Últimos videos</h2>
  {{#if videos.length}}
    <div class="rejilla">
      {{#each videos}}
        {{> video-card}}
      {{/each}}
    </div>
    <p><a href="/videos">Ver todos los videos →</a></p>
  {{else}}
    <p class="vacio">Todavía no hay videos publicados. Ejecuta <code>npm run seed</code> para cargar datos de prueba.</p>
  {{/if}}
</section>
